<div id="<%= dom_id venue %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= venue.name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Address:</strong>
    <%= venue.address %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">User:</strong>
    <%= venue.user_id %>
  </p>

</div>
