<div class="container mx-auto pt-24">
  <!-- Gambar Venue -->
  <div class="flex justify-center items-center w-full">
    <% if @venue.image.attached? %>
      <%= image_tag url_for(@venue.image), class: "flex w-full h-[400px] object-cover rounded-lg shadow-lg" %>
    <% else %>
      <p class="text-center text-gray-700">No file attached</p>
    <% end %>
  </div>

  <!-- Venue Description dan Price -->
  <div class="pt-6 w-full flex justify-between items-start">
    <div class="w-2/3">
      <h1 class="text-3xl font-bold text-gray-900"><%= @venue.name %></h1>
      <p class="text-gray-600 text-sm"><%= @venue.address %>, <%= @venue.city %></p>
      <p class="pt-6 text-gray-600"><%= @venue.description %></p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-md mt-5 text-right w-1/3">
      <p class="text-gray-500 text-sm">Mulai dari</p>
      <p class="text-2xl font-bold text-gray-900"><%= number_to_currency(@venue.price, unit: "Rp. ") %></p>
      <span class="text-gray-400 text-sm">Per Sesi</span>
      <button class="mt-4 w-full px-6 py-2 bg-blue-800 text-white rounded-lg hover:bg-blue-900">
        Lihat Schedule
      </button>
    </div>
  </div>

  <!-- Location Map -->
  <hr class="border-t-2 border-gray-200 mt-6">
  <div class="pt-6">
    <h2 class="text-lg font-semibold text-gray-900">Lokasi Venue</h2>
    <div class="inline-flex items-center bg-gray-100 p-4 rounded-lg mt-4">
      <p class="text-base font-medium"><%= @venue.address %>, <%= @venue.city %></p>
      <div class="relative ml-4">
        <%= link_to image_tag("maps.jpg", class: "w-20 h-auto rounded-md"), "https://www.google.com/maps/search/?api=1&query=#{@venue.address}, #{@venue.city}", target: "_blank" %>
      </div>
    </div>
  </div>

  <!-- Facilities -->
  <hr class="border-t-2 border-gray-200 mt-6">
  <div class="pt-6">
    <h2 class="text-lg font-semibold text-gray-900">Fasilitas</h2>
    <div class="flex flex-col space-y-2 mt-2">
      <span class="inline-block px-4 py-2 bg-gray-200 rounded-full">Wi-Fi</span>
      <span class="inline-block px-4 py-2 bg-gray-200 rounded-full">Kamar Ganti</span>
      <span class="inline-block px-4 py-2 bg-gray-200 rounded-full">Parkir</span>
    </div>
  </div>

  <!-- Schedule -->
  <hr class="border-t-2 border-gray-200 mt-6">
  <div class="pt-6">
    <h2 class="text-lg font-semibold text-gray-900">Pilih Lapangan dan Waktu</h2>
    <div class="flex items-center space-x-4 mb-6 mt-6">
      <div class="flex items-center">
        <% (Date.today..(Date.today + 6.days)).each do |date| %>
          <%= link_to client_venue_path(@venue, date: date), class: "px-4 py-2 rounded-md #{'bg-blue-800 text-white' if date == @selected_date}" do %>
            <div class="text-center">
              <p class="text-gray-500 text-xs"><%= date.strftime('%a') %></p>
              <p class="font-semibold text-sm"><%= date.strftime('%-d %b') %></p>
            </div>
          <% end %>
        <% end %>
      </div>
      <button class="bg-gray-200 p-2 rounded-md"><%= image_tag 'kalender.png', alt: 'Kalender', class: 'w-6 h-6' %></button>
      <button class="bg-gray-200 p-2 rounded-md">Filter waktu</button>
    </div>

    <!-- Lapangan yang Tersedia -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @fields.each do |field| %>
        <div class="border rounded-lg overflow-hidden shadow hover:shadow-lg transition-shadow cursor-pointer mb-8">
          <%= link_to client_venue_field_path(@venue, field), class: "block" do %>
            <% if field.image.attached? %>
              <%= image_tag url_for(field.image), class: "w-66 h-64 object-cover" %>
            <% else %>
              <p class="text-center text-gray-700">No image available</p>
            <% end %>
            <div class="p-4 bg-white">
              <p class="text-sm text-[#072243] font-semibold"><%= field.field_type %></p>
              <h2 class="font-semibold text-gray-700 text-lg"><%= field.name %></h2>
              <% available = field.schedules.any? { |schedule| schedule.date == @selected_date && !schedule.booked? } %>
              <p class="text-sm text-gray-500 mt-2">
                <%= available ? "Available" : "Unavailable" %>
              </p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Reschedule & Cancellation Section -->
  <hr class="border-t-2 border-gray-200 mt-6">
  <div class="pt-6">
    <h2 class="text-lg font-semibold text-gray-900">Reschedule & Pembatalan</h2>
    <p class="text-gray-700">Reservasi tidak dapat dibatalkan dan tidak ada refund.</p>
  </div>

  <!-- Reviews Section -->
  <hr class="border-t-2 border-gray-200 mt-6">
  <div class="pt-6">
    <h2 class="text-lg font-semibold text-gray-900">Ulasan</h2>
    <div class="space-y-4 mt-4 mb-6">
      <!-- Example Review 1 -->
      <div class="p-4 bg-gray-100 rounded-lg">
        <h4 class="font-semibold">Yuza Nugraha</h4>
        <p class="text-gray-600">Kebersihan: ⭐⭐⭐⭐⭐</p>
        <p class="text-gray-600">Kondisi Lapangan: ⭐⭐⭐⭐⭐</p>
        <p class="text-gray-600">Koneksi: ⭐⭐⭐⭐</p>
      </div>
      <!-- Example Review 2 -->
      <div class="p-4 bg-gray-100 rounded-lg mb-6">
        <h4 class="font-semibold">Akmal Fikron</h4>
        <p class="text-gray-600">Kebersihan: ⭐⭐⭐⭐</p>
        <p class="text-gray-600">Kondisi Lapangan: ⭐⭐⭐⭐</p>
        <p class="text-gray-600">Koneksi: ⭐⭐⭐⭐</p>
      </div>
    </div>
  </div>
</div>
