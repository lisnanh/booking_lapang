<div class="mx-auto md:w-2/3 w-full flex">
  <div class="mx-auto">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
    <% end %>

    <%= render @field %>

    <div class="container mx-auto p-6 pt-24">
    <%= link_to "Edit this field", edit_field_path(@field), class: "mt-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium pt-26" %>
    <%= link_to "Back to fields", fields_path, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <div class="inline-block ml-2">
      <%= button_to "Destroy this field", @field, method: :delete, class: "mt-2 rounded-lg py-3 px-5 bg-gray-100 font-medium" %>
    </div>
    </div>
  </div>
</div>
